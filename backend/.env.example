# Copy to backend/.env (gitignored). Do not put these in frontend/.env or Vercel production yet.
# Production API keeps MONGO_URI. Do not replace it for cutover.

# --- Existing app (production / default) ---
# MONGO_URI=
# JWT_SECRET=
# REDIS_URL=
# R2_*  (unchanged)

# --- Driver (local isolated / staging only) ---
# DB_DRIVER=mongo
# DB_DRIVER=postgres

# --- Postgres (Express uses pg, not the browser Data API) ---
# Transaction pooler :6543 — Vercel/serverless runtime
# DATABASE_URL=postgresql://postgres.<PROJECT_REF>:<DB_PASSWORD>@aws-0-<REGION>.pooler.supabase.com:6543/postgres?sslmode=require
# Direct :5432 — migrations, mongosh-style long sessions only
# DATABASE_URL_DIRECT=postgresql://postgres:<DB_PASSWORD>@db.<PROJECT_REF>.supabase.co:5432/postgres?sslmode=require
# ALLOW_SUPABASE_MIGRATE=staging

# --- Supabase platform keys (backend only; never NEXT_PUBLIC_*) ---
# SUPABASE_URL=https://<PROJECT_REF>.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# SUPABASE_SECRET_KEY=sb_secret_...
# SUPABASE_JWKS_URL=https://<PROJECT_REF>.supabase.co/auth/v1/.well-known/jwks.json

# Auth stays Express JWT. Do not enable Supabase Auth for this migration.
# Publishable/secret keys are not DATABASE_URL. Get pooler+direct URLs from
# Supabase → Project Settings → Database. Do not paste them in chat.

# --- Self-serve editor (product defaults; not secrets) ---
# EDITOR_TERMS_VERSION=2026-09-23
# SELF_SERVE_EDITOR_MANHUA_LIMIT_PER_DAY=5
# SELF_SERVE_EDITOR_UPLOAD_BYTES_PER_DAY=524288000
# SELF_SERVE_EDITOR_QUOTA_WINDOW_HOURS=24
# SELF_SERVE_EDITOR_SIGNUP=true
# These quotas apply only to users who became editor via Profile onboarding.
# Existing admin/editor/translator accounts are not auto-enrolled.
# SELF_SERVE_EDITOR_SIGNUP=false closes POST /api/user/become-editor for new users.
# Existing editors keep role, publish permission, and quota enforcement.

# --- Self-serve team create (product defaults; not secrets) ---
# SELF_SERVE_TEAM_CREATION_ENABLED=true
# SELF_SERVE_TEAM_ACTIVE_LIMIT=2
# SELF_SERVE_TEAM_CREATE_MAX=5
# SELF_SERVE_TEAM_CREATE_WINDOW_MS=3600000
# Flag false blocks only new editor self-serve creates. Site admin can still POST /api/editor/teams.
# Existing teams, membership, recruitment, and quota stay. Distinct from TEAM_RECRUITMENT_ENABLED.
# Active ownership count = team_members.role='owner' on existing teams (hard delete; no deleted_at).

# --- Deploy identity (Vercel Production) ---
# NODE_ENV=production
# Do not set NODE_ENV=development on Production: errorHandler would send stack traces.
# Health commit comes from VERCEL_GIT_COMMIT_SHA. Do not pin a stale GIT_COMMIT env.
