# Copy to backend/.env (gitignored). Do not put these in frontend/.env or Vercel production yet.
# Production API keeps MONGO_URI. Do not replace it for cutover.

# --- Existing app (production / default) ---
# MONGO_URI=
# JWT_SECRET=
# REDIS_URL=
# R2_*  (unchanged)

# --- Driver (local isolated / staging only) ---
# DB_DRIVER=mongo
# DB_DRIVER=postgres

# --- Postgres (Express uses pg, not the browser Data API) ---
# Transaction pooler :6543 — Vercel/serverless runtime
# DATABASE_URL=postgresql://postgres.<PROJECT_REF>:<DB_PASSWORD>@aws-0-<REGION>.pooler.supabase.com:6543/postgres?sslmode=require
# Direct :5432 — migrations, mongosh-style long sessions only
# DATABASE_URL_DIRECT=postgresql://postgres:<DB_PASSWORD>@db.<PROJECT_REF>.supabase.co:5432/postgres?sslmode=require
# ALLOW_SUPABASE_MIGRATE=staging

# --- Supabase platform keys (backend only; never NEXT_PUBLIC_*) ---
# SUPABASE_URL=https://<PROJECT_REF>.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# SUPABASE_SECRET_KEY=sb_secret_...
# SUPABASE_JWKS_URL=https://<PROJECT_REF>.supabase.co/auth/v1/.well-known/jwks.json

# Auth stays Express JWT. Do not enable Supabase Auth for this migration.
# Publishable/secret keys are not DATABASE_URL. Get pooler+direct URLs from
# Supabase → Project Settings → Database. Do not paste them in chat.
